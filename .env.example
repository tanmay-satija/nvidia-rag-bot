# Get a free API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Model used for generation (availability depends on your Groq account)
GROQ_MODEL=openai/gpt-oss-120b

# Local embedding model (downloaded from HuggingFace on first run)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Set your real contact email before downloading SEC filings
SEC_USER_AGENT=NVIDIA RAG research your-name your-email@example.com
